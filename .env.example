# Copy to .env and fill in. .env is gitignored.

# ── The model under test ─────────────────────────────────────────────────────
# Any OpenAI-compatible endpoint. The agent has no provider-specific code, so
# this is the only line that changes between OpenAI, a gateway, or a self-hosted
# model. Leave OPENAI_BASE_URL unset to talk to OpenAI directly.
OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://your-gateway/v1
AGENT_MODEL=claude-haiku-4-5
JUDGE_MODEL=claude-haiku-4-5

# ── Where the traces go ──────────────────────────────────────────────────────
# Nothing else in the repo changes between these. That is the point.
#
# A) Local Phoenix (default). `phoenix serve`, then leave both unset.
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
#
# B) Phoenix Cloud or a self-hosted instance.
# PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com
# PHOENIX_API_KEY=...
#
# C) Arize AX.
# ARIZE_SPACE_ID=...
# ARIZE_API_KEY=...

GOLDEN_PROJECT=jwst-golden
PRODUCTION_PROJECT=jwst-production
